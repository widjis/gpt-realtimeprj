# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Server Configuration
PORT=3001

# MCP (Model Context Protocol) Configuration
# n8n MCP Server URL for workflow automation
MCP_SERVER_URL=https://n8nprod.merdekabattery.com:5679/mcp/server
# Set to '0' to allow self-signed certificates (development only)
NODE_TLS_REJECT_UNAUTHORIZED=0

# Instructions:
# 1. Copy this file to .env
# 2. Replace 'your_openai_api_key_here' with your actual OpenAI API key
# 3. Update MCP_SERVER_URL if using a different n8n server
# 4. Make sure .env is in your .gitignore to keep your API key secure